#include <SPI.h>
#include <max6675.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// --- LCD Settings ---
LiquidCrystal_I2C lcd(0x27, 16, 2);

// --- MAX6675 Pin Connections ---
const int thermoDO = 12;  // SO (Data Out)
const int thermoCS = 10;  // CS (Chip Select)
const int thermoCLK = 13; // SCK (Clock)
MAX6675 thermocouple(thermoCLK, thermoCS, thermoDO);

// --- Fan & Button Pin Definitions ---
const int fanPin = 9;       // Connected to XY-MOS TRIG/PWM
const int btnUpPin = 2;     // Button 1 (Increase Speed)
const int btnDownPin = 3;   // Button 2 (Decrease Speed)
const int btnMutePin = 5;   // Button 3 (Mute Alarm) - NEW!

// --- Buzzer Pin Definitions ---
const int buzzerPin = 4;    // 3-Pin Buzzer Module I/O on Pin 4

// --- Variables for Fan Speed Control & Mute ---
int fanSpeed = 0;           // Current PWM value (0 - 255)
const int speedStep = 25;   // Amount to increase/decrease per press
int lastDisplayedSpeed = -1;// Tracks changes to prevent unnecessary LCD flickering
bool buzzerMuted = false;   // Tracks if user has silenced the alarm

// --- Timing Variables for Temperature Refresh ---
unsigned long previousMillis = 0;
const long interval = 1000; // Refresh temperature every 1 second

// --- Safety Threshold ---
// (Change this back to 600.0 when done testing!)
const double maxTempLimit = 600.0; // Temporary test threshold

void setup() {
  Serial.begin(9600);
  
  // 1. FORCE BUZZER PIN HIGH IMMEDIATELY TO STOP FLOATING/BEEPING
  pinMode(buzzerPin, OUTPUT);
  digitalWrite(buzzerPin, HIGH); 
  
  // Initialize other pins
  pinMode(fanPin, OUTPUT);
  pinMode(btnUpPin, INPUT_PULLUP);
  pinMode(btnDownPin, INPUT_PULLUP);
  pinMode(btnMutePin, INPUT_PULLUP); // NEW Mute Button
  
  analogWrite(fanPin, fanSpeed); // Ensure fan starts OFF
  
  // Initialize LCD
  lcd.init();                      
  lcd.backlight();
  
  // Initial Startup Screen & Startup Beep
  lcd.setCursor(0, 0);
  lcd.print("Waste Oil Stove");
  lcd.setCursor(0, 1);
  lcd.print("System Starting ");
  
  // Quick startup beep (LOW = ON for 3-pin module)
  digitalWrite(buzzerPin, LOW);  
  delay(150);
  digitalWrite(buzzerPin, HIGH); 
  
  delay(1500);
  lcd.clear();
}

void loop() {
  // 1. Read Button UP (Pin 2)
  if (digitalRead(btnUpPin) == LOW) {
    fanSpeed = fanSpeed + speedStep;
    if (fanSpeed > 255) fanSpeed = 255;
    analogWrite(fanPin, fanSpeed);
    delay(200); // Debounce delay
  }

  // 2. Read Button DOWN (Pin 3)
  if (digitalRead(btnDownPin) == LOW) {
    fanSpeed = fanSpeed - speedStep;
    if (fanSpeed < 0) fanSpeed = 0;
    analogWrite(fanPin, fanSpeed);
    delay(200); // Debounce delay
  }

  // 3. Read Mute Button (Pin 5) - NEW!
  if (digitalRead(btnMutePin) == LOW) {
    buzzerMuted = true;
    digitalWrite(buzzerPin, HIGH); // Turn buzzer OFF immediately
    Serial.println("Alarm Muted by User.");
    delay(200); // Debounce delay
  }

  // 4. Update Fan Speed on LCD (Row 1)
  if (fanSpeed != lastDisplayedSpeed) {
    lastDisplayedSpeed = fanSpeed;
    int fanPercent = map(fanSpeed, 0, 255, 0, 100);

    lcd.setCursor(0, 1);
    lcd.print("Fan Speed: ");
    lcd.print(fanPercent);
    lcd.print("%    ");
  }

  // 5. Read Temperature and Update LCD (Row 0) every 1 second
  unsigned long currentMillis = millis();
  if (currentMillis - previousMillis >= interval) {
    previousMillis = currentMillis;

    double celsius = thermocouple.readCelsius();
    
    lcd.setCursor(0, 0);
    if (isnan(celsius)) {
      lcd.print("Temp: Error     ");
      digitalWrite(buzzerPin, HIGH); // Keep buzzer OFF on error
    } else {
      lcd.print("Temp: ");
      lcd.print(celsius);
      lcd.print(" C     ");

      // Threshold Alarm Check with Mute Integration
      if (celsius >= maxTempLimit) {
        if (!buzzerMuted) {
          digitalWrite(buzzerPin, LOW); // Turn Buzzer ON (Low-level trigger)
          Serial.println("WARNING: Temperature Threshold Reached!");
        } else {
          digitalWrite(buzzerPin, HIGH); // Over threshold, but Muted by user
        }
      } else {
        digitalWrite(buzzerPin, HIGH); // Below threshold, turn Buzzer OFF
        buzzerMuted = false;           // Reset mute state once temperature is safe again
      }
    }
  }
}
